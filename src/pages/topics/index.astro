---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import {
    FEATURED_TOPICS,
    EXCLUDED_FROM_POPULAR,
    POPULAR_LIMIT,
} from "../../data/featured-topics";

const allNotes = await getCollection("notes");

const topicCounts: Record<string, number> = {};
allNotes.forEach((note) => {
    note.data.tags.forEach((topic: string) => {
        topicCounts[topic] = (topicCounts[topic] || 0) + 1;
    });
});

const sortedTopics = Object.entries(topicCounts).sort((a, b) => a[0].localeCompare(b[0], undefined, { sensitivity: 'base' }));

const featuredSet = new Set<string>();
const popularTopics: Array<[string, number, boolean]> = [];

for (const topic of FEATURED_TOPICS) {
    if (topicCounts[topic] && !featuredSet.has(topic)) {
        popularTopics.push([topic, topicCounts[topic], true]);
        featuredSet.add(topic);
        if (popularTopics.length >= POPULAR_LIMIT) break;
    }
}

if (popularTopics.length < POPULAR_LIMIT) {
    const excluded = new Set(EXCLUDED_FROM_POPULAR);
    const topByCount = Object.entries(topicCounts)
        .filter(([topic]) => !featuredSet.has(topic) && !excluded.has(topic))
        .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
    for (const [topic, count] of topByCount) {
        if (popularTopics.length >= POPULAR_LIMIT) break;
        popularTopics.push([topic, count, false]);
    }
}

const popularNames = new Set(popularTopics.map(([topic]) => topic));

const groupedTopics = sortedTopics.reduce((acc, [topic, count]) => {
    let firstChar = topic[0].toUpperCase();
    if (!/^[A-Z]$/.test(firstChar)) {
        firstChar = "#";
    }
    if (!acc[firstChar]) {
        acc[firstChar] = [];
    }
    acc[firstChar].push([topic, count]);
    return acc;
}, {} as Record<string, typeof sortedTopics>);

const alphabet = Object.keys(groupedTopics).sort((a, b) => {
    if (a === "#") return -1;
    if (b === "#") return 1;
    return a.localeCompare(b);
});

const topicSlug = (topic: string) => topic.replace(/\s+/g, '-').toLowerCase();
---

<Layout
    title="Topics Index | Malcolm Bastien"
    description="Browse the collection by subject."
    type="website"
>
    <main class="w-full">
        <div class="w-full max-w-page mx-auto px-margin-mobile md:px-gutter py-12 md:py-16">
            <!-- Masthead -->
            <section class="flex flex-col gap-6 pb-8">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center gap-2 text-text-muted">
                        <span class="font-code-sm text-[0.6875rem] uppercase tracking-wider text-accent-flow font-medium">Archives</span>
                        <span class="text-text-muted font-code-sm text-[0.6875rem]">/</span>
                        <span class="font-code-sm text-[0.6875rem] uppercase tracking-wider text-text-secondary">Explore by Theme</span>
                    </div>
                </div>
                <div class="max-w-3xl flex flex-col gap-4">
                    <h1 class="font-display text-display-mobile md:text-display text-text-primary tracking-tight">Topics</h1>
                    <p class="font-body-lead text-body-lead text-text-secondary">
                        Browse every thread of thinking, organised into a living taxonomy of subjects and themes.
                    </p>
                </div>
            </section>

            <!-- Popular Topics -->
            {popularTopics.length > 0 && (
                <section class="flex flex-col gap-6 py-10 border-t border-border-delicate">
                    <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                        <div>
                            <span class="font-code-sm text-[0.6875rem] uppercase tracking-wider text-accent-flow font-semibold">Focus Areas</span>
                            <h2 class="font-headline-md text-headline-md text-text-primary tracking-tight">Popular Topics</h2>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        {popularTopics.map(([topic, count]) => (
                            <a class="group relative p-6 rounded-xl bg-surface-card border border-border-delicate hover:border-accent-flow transition-all duration-200 hover:-translate-y-0.5 flex flex-col justify-between" href={`/topics/${topicSlug(topic)}`}>
                                <div class="flex flex-col gap-2.5">
                                    <div class="flex items-center justify-between">
                                        <h3 class="font-headline-sm text-headline-sm text-text-primary group-hover:text-accent-flow transition-colors">{topic}</h3>
                                        <span class="px-2 py-0.5 rounded-full font-code-sm text-[0.75rem] font-medium bg-accent-flow-soft text-accent-flow border border-accent-flow/20">{count}</span>
                                    </div>
                                </div>
                            </a>
                        ))}
                    </div>
                </section>
            )}

            <!-- Alphabetical Index -->
            <section class="flex flex-col gap-8 py-10 border-t border-border-delicate">
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
                    <div>
                        <span class="font-code-sm text-[0.6875rem] uppercase tracking-wider text-accent-flow font-semibold">Master Reference</span>
                        <h2 class="font-headline-md text-headline-md text-text-primary tracking-tight">Complete Alphabetical Index</h2>
                    </div>
                </div>

                <nav aria-label="Alphabetical Jump Bar" class="sticky top-20 z-20 py-2.5 px-4 rounded-xl bg-surface-page/90 backdrop-blur-md border border-border-delicate shadow-xs overflow-x-auto no-scrollbar flex items-center justify-between gap-1 text-[0.75rem] font-code-sm">
                    {alphabet.map((char) => (
                        <a class="px-2 py-1 rounded hover:bg-surface-subtle text-text-secondary hover:text-accent-flow transition-colors" href={`#letter-${char === "#" ? "num" : char}`}>{char}</a>
                    ))}
                </nav>

                <div class="flex flex-col gap-10" id="topics-grid">
                    {alphabet.map((letter) => {
                        const topics = groupedTopics[letter];
                        return (
                            <div class="topic-letter-group scroll-mt-36 p-6 rounded-xl bg-surface-card border border-border-delicate" id={`letter-${letter === "#" ? "num" : letter}`}>
                                <div class="flex items-baseline justify-between pb-4 mb-4 border-b border-border-delicate">
                                    <span class="font-display text-headline-lg text-accent-flow">{letter}</span>
                                    <span class="font-code-sm text-[0.6875rem] text-text-muted uppercase tracking-wider">{letter === "#" ? "Numeric & Brands" : `${topics.length} Topics`}</span>
                                </div>
                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5">
                                    {topics.map(([topic, count]) => {
                                        const isPopular = popularNames.has(topic);
                                        return (
                                            <a class:list={["topic-item flex items-center justify-between p-2 rounded-lg transition-colors group", isPopular ? "hover:bg-accent-flow-soft" : "hover:bg-surface-subtle"]} href={`/topics/${topicSlug(topic)}`}>
                                                <span class:list={["font-body-sm text-body-sm transition-colors", isPopular ? "font-medium text-accent-flow" : "text-text-primary group-hover:text-accent-flow"]}>{topic}</span>
                                                <span class:list={["font-code-sm text-[0.75rem]", isPopular ? "text-accent-flow font-semibold" : "text-text-muted"]}>{count}</span>
                                            </a>
                                        );
                                    })}
                                </div>
                            </div>
                        );
                    })}
                </div>
            </section>
        </div>
    </main>
</Layout>

<script>
    const searchInput = document.getElementById("topic-search-input") as HTMLInputElement | null;
    const topicItems = document.querySelectorAll<HTMLElement>(".topic-item");
    const letterGroups = document.querySelectorAll<HTMLElement>(".topic-letter-group");

    if (searchInput) {
        const filterTopics = (query: string) => {
            const cleanQuery = query.toLowerCase().trim();
            letterGroups.forEach((group) => {
                let visible = 0;
                group.querySelectorAll<HTMLElement>(".topic-item").forEach((item) => {
                    const match = (item.textContent || "").toLowerCase().includes(cleanQuery);
                    item.style.display = match ? "flex" : "none";
                    if (match) visible++;
                });
                group.style.display = visible === 0 && cleanQuery.length > 0 ? "none" : "block";
            });
            topicItems.length; // keep reference
        };

        searchInput.addEventListener("input", (e) => filterTopics((e.target as HTMLInputElement).value));

        window.addEventListener("keydown", (e) => {
            if ((e.key === "/" && document.activeElement !== searchInput) || ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k")) {
                e.preventDefault();
                searchInput.focus();
                searchInput.select();
            }
            if (e.key === "Escape" && document.activeElement === searchInput) {
                searchInput.value = "";
                searchInput.blur();
                filterTopics("");
            }
        });
    }
</script>
