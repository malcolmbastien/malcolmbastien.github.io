---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { getReadingTime } from "../../lib/reading-time";

export async function getStaticPaths() {
    const allNotes = await getCollection("notes");
    const topics = new Set<string>();
    allNotes.forEach((note) => {
        const tags = note.data.tags || [];
        tags.forEach((tag) => topics.add(tag.toLowerCase()));
    });
    return Array.from(topics).map((topic) => ({
        params: { topic },
    }));
}

const { topic } = Astro.params;

const displayTopic = topic ? topic.charAt(0).toUpperCase() + topic.slice(1) : '';

const allNotes = await getCollection("notes");
const filteredNotes = allNotes
    .filter((note) => !note.data.draft)
    .filter((note) => {
        const tags = note.data.tags || [];
        return tags.some((tag) => tag.toLowerCase() === topic?.toLowerCase());
    });

const sortedNotes = filteredNotes.sort(
    (a, b) => {
        const dateA = a.data.publishedDate ? new Date(a.data.publishedDate).getTime() : 0;
        const dateB = b.data.publishedDate ? new Date(b.data.publishedDate).getTime() : 0;
        return dateB - dateA;
    },
);

const formatDate = (date: Date | undefined) => {
    if (!date) return '';
    return date.toLocaleDateString("en-US", { month: 'short', day: '2-digit', year: 'numeric', timeZone: 'UTC' });
};

const topicSlug = (t: string) => t.replace(/\s+/g, '-').toLowerCase();
---

<Layout
    title={`${displayTopic} | Topic Archive`}
    description={`Explore all cultivated notes and ideas regarding ${displayTopic}.`}
    type="website"
>
    <main class="w-full bg-surface-page min-h-screen" data-pagefind-ignore>
        <div class="max-w-page mx-auto px-margin-mobile md:px-gutter py-12 md:py-16">
            <!-- Eyebrow & Breadcrumb -->
            <header class="flex flex-col gap-6 pb-space-lg">
                <div class="flex items-center justify-between gap-4 flex-wrap">
                    <a class="inline-flex items-center gap-2 font-code-sm text-code-sm text-text-secondary hover:text-accent-flow transition-colors group" href="/topics">
                        <span class="material-symbols-outlined text-[16px] text-text-muted group-hover:text-accent-flow transition-transform group-hover:-translate-x-1">arrow_back</span>
                        <span>TOPIC ARCHIVE / TAXONOMY</span>
                    </a>
                    <span class="font-code-sm text-code-sm text-text-muted">{sortedNotes.length} Notes</span>
                </div>
                <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8">
                    <div class="max-w-2xl">
                        <span class="font-code-sm text-code-sm uppercase tracking-widest text-accent-flow font-medium block mb-2">Core Taxonomy</span>
                        <h1 class="font-display text-display-mobile md:text-display text-text-primary tracking-tight">{displayTopic}</h1>
                    </div>
                </div>
            </header>

            <!-- Editorial Timeline List -->
            <section class="w-full flex flex-col divide-y divide-border-delicate" id="articles-container">
                <h2 class="sr-only">Notes</h2>
                {sortedNotes.map((note) => {
                    const hasCover = note.data.cover;
                    const readingTime = getReadingTime(note.body);
                    return (
                        <article class="article-entry group py-space-lg hover:bg-surface-subtle/50 transition-colors px-2 -mx-2 rounded-lg">
                            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start">
                                <div class="md:col-span-3 flex flex-col gap-1">
                                    <time class="font-code-sm text-code-sm text-text-muted uppercase tracking-wider font-medium">{formatDate(note.data.publishedDate)}</time>
                                    {readingTime && (
                                        <div class="flex items-center gap-2 font-code-sm text-[0.75rem] text-text-secondary"><span>{readingTime}</span></div>
                                    )}
                                </div>
                                <div class="md:col-span-9 flex gap-6">
                                    {hasCover && (
                                        <a class="hidden sm:block w-32 aspect-square shrink-0 overflow-hidden rounded-lg bg-surface-subtle border border-border-delicate" href={`/notes/${note.id.replace('.md', '')}`}>
                                            <Image
                                                src={note.data.cover!}
                                                alt={note.data.title}
                                                class="w-full h-full object-cover"
                                            />
                                        </a>
                                    )}
                                    <div class="flex flex-col gap-3">
                                        <h3 class="font-headline-md text-headline-md text-text-primary group-hover:text-accent-flow transition-colors leading-snug">
                                            <a class="inline-flex items-center gap-2" href={`/notes/${note.id.replace('.md', '')}`}>
                                                <span>{note.data.title}</span>
                                                <span class="material-symbols-outlined text-[18px] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all text-accent-flow">arrow_forward</span>
                                            </a>
                                        </h3>
                                        {note.data.summary && (
                                            <p class="font-body-md text-body-md text-text-secondary leading-relaxed">{note.data.summary}</p>
                                        )}
                                        <div class="flex flex-wrap items-center gap-2 pt-1">
                                            {note.data.tags.map((tag) => {
                                                const isCurrent = tag.toLowerCase() === topic?.toLowerCase();
                                                return (
                                                    <a class:list={["font-code-sm text-[0.6875rem] px-2 py-0.5 rounded border", isCurrent ? "text-accent-flow bg-accent-flow-soft border-accent-flow/15" : "text-text-muted bg-surface-card border-border-delicate hover:text-accent-flow"]} href={`/topics/${topicSlug(tag)}`}>
                                                        #{tag}
                                                    </a>
                                                );
                                            })}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    );
                })}
            </section>

            <!-- View Archive Button -->
            <div class="pt-12 border-t border-border-delicate flex justify-center">
                <a href="/archives" class="inline-flex items-center gap-2 px-8 py-3 bg-text-primary text-surface-page font-label-caps text-label-caps uppercase tracking-widest rounded-lg hover:-translate-y-0.5 transition-transform duration-200 shadow-sm">
                    View Archive History
                    <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                </a>
            </div>
        </div>
    </main>
</Layout>
