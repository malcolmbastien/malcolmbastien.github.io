---
import Layout from "../layouts/Layout.astro";
import SearchComponent from "../components/Navigation/Search.astro";
---

<Layout
    title="Search | Malcolm Bastien"
    description="Search through my writings on Agile delivery, flow, systems thinking, and organizational change."
>
    <Fragment slot="head">
        {import.meta.env.PROD && (
            <>
                <link href="/pagefind/pagefind-ui.css" rel="stylesheet">
                <script src="/pagefind/pagefind-ui.js" is:inline></script>
            </>
        )}
        <style is:inline>
            .search-highlight,
            mark {
                background-color: #FBF1ED;
                color: inherit;
                padding: 0 2px;
                border-radius: 2px;
            }
            .dark .search-highlight,
            .dark mark {
                background-color: #2a1c15;
                color: #f2f1ee;
            }
        </style>
    </Fragment>

    <main class="w-full" data-pagefind-ignore>
        <div class="max-w-3xl mx-auto px-margin-mobile md:px-gutter py-12 md:py-16">
            <header class="mb-10">
                <span class="font-code-sm text-code-sm uppercase tracking-widest text-accent-flow font-medium block mb-2">Explore the Archive</span>
                <h1 class="font-display text-display-mobile md:text-display text-text-primary tracking-tight">Search</h1>
            </header>

            <SearchComponent />
        </div>
    </main>
</Layout>
