                            <h3 class="font-headline-md text-headline-md text-text-primary">Agile Coach</h3>
                            <span class="font-code-sm text-code-sm text-accent-flow font-medium">2026 — Present</span>
                        </div>
                        <div class="font-body-sm text-body-sm text-text-muted mb-4">CIBC • Toronto, Ontario</div>
                        <p class="font-body-md text-body-md text-text-secondary leading-relaxed">

                        </p>
                    </div>

                    <!-- Senior Agile Coach -->
