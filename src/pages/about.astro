                                <h3 class="font-headline-md text-headline-md text-text-primary">{role.role}</h3>
                                <span class="font-code-sm text-code-sm text-text-muted">{role.date}</span>
                            </div>
                            <div class="font-body-sm text-body-sm text-text-muted mb-4">
                                {role.company} • {role.location}{role.note ? ` • ${role.note}` : ""}
