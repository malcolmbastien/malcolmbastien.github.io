            <!-- Published Tools -->
            <section class="w-full py-12 md:py-16" id="tools">
                <div class="max-w-[46rem] mb-10">
                    <span class="font-code-sm text-code-sm text-accent-flow uppercase tracking-wider block mb-1">Open-Source &amp; Practitioner Tooling</span>
                    <h2 class="font-headline-lg text-headline-lg text-text-primary mb-3">Published Tools</h2>
                    <p class="font-body-md text-body-md text-text-secondary">
                        Interactive software, diagnostic frameworks, and official Miro templates built for agile coaches and delivery leads.
                    </p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                    {publishedTools.map((tool) => {
                        const Tag = tool.link ? "a" : "div";
                        return (
                            <Tag
                                href={tool.link}
                                target={tool.link ? "_blank" : undefined}
                                rel={tool.link ? "noopener noreferrer" : undefined}
                                class="group bg-surface-subtle p-5 rounded-lg hover:bg-surface-card hover:shadow-sm transition-all flex flex-col justify-between"
                            >
                                <div>
                                    <span class="material-symbols-outlined text-[22px] text-accent-flow mb-2">{tool.icon}</span>
                                    <h3 class="font-headline-md text-headline-md font-semibold text-text-primary group-hover:text-accent-flow transition-colors mb-1">{tool.title}</h3>
                                    <p class="font-body-sm text-[0.8125rem] text-text-secondary leading-relaxed">{tool.description}</p>
                                </div>
                                {tool.linkLabel && (
                                    <div class="mt-4 font-code-sm text-[0.7rem] text-text-muted flex items-center justify-between gap-2">
                                        <span class="truncate">{tool.linkLabel}</span>
                                        <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                                    </div>
                                )}
                            </Tag>
                        );
                    })}
                </div>
            </section>

            <!-- Expertise -->
            <section class="w-full py-12 md:py-16" id="expertise">
