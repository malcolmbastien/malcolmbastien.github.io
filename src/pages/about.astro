---

<Layout
    title="About | Malcolm Bastien - Enterprise Agile Coach"
    description="Lean-Agile Delivery and Agile Transformation Coach specializing in sociotechnical design, flow engineering, and program delivery for high-stakes, $10M+ initiatives."
    type="website"
>
    <main class="w-full" data-pagefind-ignore>
        <div class="max-w-page mx-auto px-margin-mobile md:px-gutter py-12 md:py-16">
            <!-- Hero -->
            <section class="relative w-full pb-16 md:pb-24">
                <div class="absolute -top-12 -right-8 w-80 h-80 bg-accent-flow-soft rounded-full blur-3xl opacity-60 pointer-events-none -z-10"></div>
                <div class="flex flex-col lg:flex-row gap-12 items-start">
                    <div class="max-w-[48rem] grow">
                        <div class="flex items-center gap-3 mb-6">
                            <span class="font-code-sm text-code-sm uppercase tracking-widest text-accent-flow font-medium">Profile</span>
                            <span class="text-text-muted text-xs">/</span>
                            <span class="font-code-sm text-code-sm uppercase tracking-widest text-text-muted">About</span>
                            <span class="text-text-muted text-xs">/</span>
                            <span class="font-code-sm text-code-sm uppercase tracking-widest text-text-muted flex items-center gap-1.5">Toronto, Canada <span role="img" aria-label="Canada" title="Canada">🍁</span></span>
                        </div>
                        <h1 class="font-display text-display-mobile md:text-display text-text-primary tracking-tight mb-4">
                            Malcolm Bastien
                        </h1>
                        <p class="font-headline-sm text-headline-sm text-accent-flow mb-6 font-medium">
                            Lean-Agile Delivery &amp; Transformation Coach
                        </p>
                        <p class="font-body-lead text-body-lead text-text-secondary leading-relaxed mb-8 max-w-[42rem]">
                            Enterprise Agile Coach helping leaders in Fintech, Banking, and HealthTech build fast flow through systems thinking and aligned autonomy, empowering teams to deliver high-performance results at scale.
                        </p>
                        <div class="flex flex-wrap items-center gap-2 pt-2">
                            {socialLinks.map((social) => (
                                <a class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-card hover:bg-surface-subtle text-text-primary font-body-sm text-body-sm transition-all shadow-sm" href={social.href} rel="noopener noreferrer" target="_blank">
                                    <span class="material-symbols-outlined text-[18px] text-accent-flow">{social.icon}</span>
                                    <span>{social.label}</span>
                                </a>
                            ))}
                        </div>
                    </div>
                    <div class="w-40 md:w-56 shrink-0 overflow-hidden rounded-xl bg-surface-container shadow-sm">
                        <Image
                            src={portrait}
                            alt="Malcolm Bastien"
                            class="w-full h-auto"
                            widths={[160, 224, 384, 512]}
                            sizes="(max-width: 768px) 160px, 224px"
                            quality={90}
                            loading="eager"
                        />
                    </div>
                </div>
            </section>

            <!-- What I Do -->
            <section class="w-full py-12 md:py-16" id="what-i-do">
                <div class="max-w-[46rem] mb-10">
                    <span class="font-code-sm text-code-sm text-accent-flow uppercase tracking-wider block mb-1">Methodology &amp; Practice</span>
                    <h2 class="font-headline-lg text-headline-lg text-text-primary mb-3">What I Do</h2>
                    <p class="font-body-md text-body-md text-text-secondary">
                        Replacing bureaucratic friction with mathematical predictability, cognitive clarity, and humane engineering practices.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {whatIDo.map((pillar) => (
                        <div class="bg-surface-card p-6 md:p-8 rounded-xl shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
                            <div>
                                <div class="w-12 h-12 rounded-lg bg-surface-subtle flex items-center justify-center mb-5 text-accent-flow">
                                    <span class="material-symbols-outlined text-[26px]">{pillar.icon}</span>
                                </div>
                                <h3 class="font-headline-md text-headline-md text-text-primary mb-3">{pillar.title}</h3>
                                <p class="font-body-sm text-body-sm text-text-secondary leading-relaxed">{pillar.description}</p>
                            </div>
                            <div class="mt-6 pt-4 flex flex-wrap items-center gap-2 font-code-sm text-[0.75rem] text-text-muted uppercase tracking-wider">
                                {pillar.tags.map((tag, i) => (
                                    <span class="flex items-center gap-2">
                                        {i > 0 && <span>•</span>}
                                        <span>{tag}</span>
                                    </span>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- Delivery Highlights -->
            <section class="w-full py-12 md:py-16" id="highlights">
                <div class="max-w-[46rem] mb-10">
                    <span class="font-code-sm text-code-sm text-accent-flow uppercase tracking-wider block mb-1">Track Record</span>
                    <h2 class="font-headline-lg text-headline-lg text-text-primary mb-3">Delivery Highlights</h2>
                    <p class="font-body-md text-body-md text-text-secondary">
                        Direct leadership within Tier-1 financial institutions, healthcare operators, and high-velocity digital ecosystems.
                    </p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {highlights.map((sector) => (
                        <div class:list={["bg-surface-subtle p-6 rounded-xl flex flex-col justify-between", sector.wide && "md:col-span-2"]}>
                            <div>
                                <div class="flex items-center gap-2 text-accent-flow mb-4">
                                    <span class="material-symbols-outlined text-[22px]">{sector.icon}</span>
                                    <span class="font-code-sm text-[0.75rem] uppercase tracking-wider font-semibold">{sector.label}</span>
                                </div>
