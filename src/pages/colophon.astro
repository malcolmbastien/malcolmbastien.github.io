---
import Layout from "../layouts/Layout.astro";

const developmentTools = [
    {
        name: "Zed",
        domain: "zed.dev",
        icon: "terminal",
        description: "A high-performance code editor written in Rust. Its near-zero latency and collaborative environment make it my main coding tool.",
        link: "https://zed.dev",
    },
    {
        name: "Open Code",
        domain: "opencode.ai",
        icon: "terminal",
        description: "An interactive coding assistant for architectural decisions and reducing boilerplate.",
        link: "https://opencode.ai",
    },
    {
        name: "Google Stitch",
        domain: "stitch.withgoogle.com",
        icon: "palette",
        description: "My design tool for creating and maintaining the site's visual language, design system, and responsive components.",
        link: "https://stitch.withgoogle.com",
    }
];

const workflowTools = [
    {
        name: "Obsidian",
        description: "Where all my Markdown writing happens. Its graph-based structure lets ideas connect before they reach a draft.",
        link: "https://obsidian.md",
    },
    {
        name: "Obsidian Git",
        description: "Automated commits for publishing. A single shortcut takes a note to a published post.",
        link: "https://github.com/denolehov/obsidian-git",
    }
];

const deploymentTools = [
    {
        name: "Vercel",
        description: "Static site generation paired with edge deployment provides sub-100ms load times globally.",
        link: "https://vercel.com",
    }
];

const techStack = [
    {
        name: "Astro",
        icon: "rocket",
        domain: "astro.build",
        description: "The web framework for content-driven websites. Ship less JS, more performance.",
        link: "https://astro.build",
    },
    {
        name: "Tailwind CSS",
        icon: "brush",
        domain: "tailwindcss.com",
        description: "Utility-first CSS framework for rapid UI development without leaving the HTML.",
        link: "https://tailwindcss.com",
    },
    {
        name: "Pagefind",
        icon: "search",
        domain: "pagefind.app",
        description: "Zero-config static search library that works entirely on the client side.",
        link: "https://pagefind.app",
    },
    {
        name: "@astrojs/sitemap",
        icon: "rss_feed",
        domain: "astrojs/sitemap",
        description: "Automated SEO infrastructure for discoverability across the open web.",
        link: "https://docs.astro.build/en/guides/integrations-guide/sitemap/",
    },
    {
        name: "Remark & Unist",
        icon: "account_tree",
        domain: "remark.js.org",
        description: "The pipeline that transforms Markdown into structured, accessible HTML.",
        link: "https://remark.js.org/",
    }
];
---

<Layout
    title="Colophon | Malcolm Bastien"
    description="How this site is built."
    type="website"
>
    <main class="w-full" data-pagefind-ignore>
        <div class="max-w-[48rem] mx-auto w-full px-margin-mobile md:px-0 py-12 md:py-16 flex flex-col gap-16">
            <!-- Header -->
            <header class="flex flex-col gap-4">
                <div class="flex items-center gap-3">
                    <span class="font-code-sm text-code-sm uppercase tracking-widest text-accent-flow font-medium">Site Specifications</span>
                    <span class="text-text-muted text-xs">/</span>
                    <span class="font-code-sm text-code-sm uppercase tracking-widest text-text-muted">Behind The Scenes</span>
                </div>
                <h1 class="font-display text-display-mobile md:text-display text-text-primary tracking-tight">Colophon</h1>
                <p class="font-body-lead text-body-lead text-text-secondary">How this site is designed, written, engineered, and maintained.</p>
            </header>

            <!-- Development & Tools -->
            <section class="flex flex-col gap-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-text-primary">
                        <span class="material-symbols-outlined text-[18px]">terminal</span>
                    </div>
                    <div>
                        <h2 class="font-headline-lg text-headline-lg text-text-primary">Development &amp; Authoring Environment</h2>
                         <p class="font-body-sm text-body-sm text-text-muted">Local tooling tuned for speed and consistency.</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    {developmentTools.map((tool) => (
                        <a class="group bg-surface-card p-5 rounded-xl flex flex-col justify-between shadow-xs hover:shadow-md transition-all" href={tool.link} rel="noopener noreferrer" target="_blank">
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <span class="font-headline-sm text-headline-sm text-text-primary group-hover:text-accent-flow transition-colors">{tool.name}</span>
                                    <span class="material-symbols-outlined text-[16px] text-text-muted group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">north_east</span>
                                </div>
                                <span class="inline-block font-code-sm text-[0.6875rem] px-2 py-0.5 bg-surface-container text-text-secondary rounded">{tool.domain}</span>
                                <p class="font-body-sm text-body-sm text-text-secondary pt-1">{tool.description}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>

            <!-- Writing & Thought Architecture -->
            <section class="flex flex-col gap-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-text-primary">
                        <span class="material-symbols-outlined text-[18px]">history_edu</span>
                    </div>
                    <div>
                        <h2 class="font-headline-lg text-headline-lg text-text-primary">Writing &amp; Thought Architecture</h2>
                         <p class="font-body-sm text-body-sm text-text-muted">From linked research notes to versioned publishing.</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {workflowTools.map((tool) => (
                        <a class="group bg-surface-card p-6 rounded-xl shadow-xs hover:shadow-md transition-all flex flex-col justify-between space-y-4" href={tool.link} rel="noopener noreferrer" target="_blank">
                            <div class="space-y-2">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="font-headline-sm text-headline-sm text-text-primary group-hover:text-accent-flow transition-colors flex items-center gap-1">
                                        {tool.name} <span class="material-symbols-outlined text-[14px] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">north_east</span>
                                    </span>
                                </div>
                                <p class="font-body-sm text-body-sm text-text-secondary">{tool.description}</p>
                            </div>
                        </a>
                    ))}
                </div>
            </section>

            <!-- Hosting & Deployment -->
            <section class="bg-primary text-on-primary p-8 rounded-xl flex flex-col space-y-6 shadow-md">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-surface-container-highest/20 flex items-center justify-center text-on-primary">
                            <span class="material-symbols-outlined text-[18px]">cloud_done</span>
                        </div>
                        <div>
                            <h2 class="font-headline-lg text-headline-lg text-on-primary">Hosting, Deployment &amp; Edge Performance</h2>
                            <p class="font-body-sm text-body-sm text-outline-variant">Distributed worldwide compute with zero runtime dependencies.</p>
                        </div>
                    </div>
                    <a class="inline-flex items-center gap-1 px-3 py-1 bg-surface-container-highest/20 hover:bg-surface-container-highest/30 rounded text-on-primary font-code-sm text-code-sm transition-colors self-start sm:self-auto" href={deploymentTools[0].link} rel="noopener noreferrer" target="_blank">
                        {deploymentTools[0].name.toLowerCase()}.com <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                    </a>
                </div>
                <p class="font-body-md text-body-md text-outline-variant">{deploymentTools[0].description}</p>
            </section>

            <!-- Typography -->
            <section class="flex flex-col space-y-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-text-primary">
                        <span class="material-symbols-outlined text-[18px]">format_size</span>
                    </div>
                    <div>
                        <h2 class="font-headline-lg text-headline-lg text-text-primary">Typographic System &amp; Specimen</h2>
                         <p class="font-body-sm text-body-sm text-text-muted">Editorial type balanced with legibility and technical precision.</p>
                    </div>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Newsreader -->
                    <div class="bg-surface-card p-6 rounded-xl shadow-xs flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-label-caps text-label-caps uppercase text-accent-flow">Headlines &amp; Display</span>
                                <span class="font-code-sm text-[0.75rem] text-text-muted">Serif • Optical 6-72</span>
                            </div>
                            <h3 class="font-headline-md text-headline-md text-text-primary">Newsreader</h3>
                            <p class="font-body-sm text-body-sm text-text-secondary">Editorial serif for headlines, article titles, display text, and pull quotes. Warm, distinctive, and grounded in traditional French/Dutch Baroque type design.</p>
                        </div>
                        <div class="bg-surface-subtle p-4 rounded-lg space-y-1">
                            <div class="font-display text-[1.5rem] text-text-primary leading-tight">Agility at the Edge — Flow, Systems &amp; Autonomy</div>
                            <div class="font-display text-[1.125rem] text-text-secondary italic">"Structure creates the space for deliberate innovation."</div>
                        </div>
                    </div>
                    <!-- Inter -->
                    <div class="bg-surface-card p-6 rounded-xl shadow-xs flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-label-caps text-label-caps uppercase text-accent-flow">Body &amp; Interface UI</span>
                                <span class="font-code-sm text-[0.75rem] text-text-muted">Sans • Dynamic Tracking</span>
                            </div>
                            <h3 class="font-headline-md text-headline-md text-text-primary">Inter</h3>
                            <p class="font-body-sm text-body-sm text-text-secondary">Highly legible neutral sans-serif designed for micro-clarity across digital screens. Used for prose, navigation, metadata, and labels.</p>
                        </div>
                        <div class="bg-surface-subtle p-4 rounded-lg space-y-2 font-body-md text-body-md text-text-primary">
                            <div class="tracking-wide">Aa Bb Cc Dd Ee Ff Gg Hh 0123456789</div>
                            <p class="text-text-secondary text-[0.875rem] leading-relaxed">Engineered letterforms optimized for reading speed on desktop and mobile viewports alike.</p>
                        </div>
                    </div>
                    <!-- JetBrains Mono -->
                    <div class="bg-surface-card p-6 rounded-xl shadow-xs flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-label-caps text-label-caps uppercase text-accent-flow">Code &amp; Technical Syntax</span>
                                <span class="font-code-sm text-[0.75rem] text-text-muted">Monospace • 400/500</span>
                            </div>
                            <h3 class="font-headline-md text-headline-md text-text-primary">JetBrains Mono</h3>
                            <p class="font-body-sm text-body-sm text-text-secondary">Monospaced typeface with heightened x-height and clear distinction between glyphs, designed for code blocks, terminal paths, and data matrices.</p>
                        </div>
                        <div class="bg-surface-container p-4 rounded-lg font-code-sm text-code-sm text-text-primary space-y-1">
                            <div class="text-text-muted">// System Architecture Spec</div>
                            <div>const pipeline = await compileAST(source);</div>
                            <div class="text-accent-flow">return renderStaticRoute(pipeline);</div>
                        </div>
                    </div>
                    <!-- Material Symbols -->
                    <div class="bg-surface-card p-6 rounded-xl shadow-xs flex flex-col justify-between space-y-4">
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="font-label-caps text-label-caps uppercase text-accent-flow">Iconography</span>
                                <span class="font-code-sm text-[0.75rem] text-text-muted">Variable • Outlined</span>
                            </div>
                            <h3 class="font-headline-md text-headline-md text-text-primary">Material Symbols</h3>
                            <p class="font-body-sm text-body-sm text-text-secondary">Variable outlined icon family (weights 200–400) providing consistent visual metaphor without visual clutter.</p>
                        </div>
                        <div class="bg-surface-subtle p-4 rounded-lg flex items-center justify-around text-text-primary">
                            <div class="flex flex-col items-center gap-1">
                                <span class="material-symbols-outlined text-[24px]">palette</span>
                                <span class="font-code-sm text-[0.6875rem] text-text-muted">palette</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <span class="material-symbols-outlined text-[24px]">auto_awesome</span>
                                <span class="font-code-sm text-[0.6875rem] text-text-muted">awesome</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <span class="material-symbols-outlined text-[24px]">lightbulb</span>
                                <span class="font-code-sm text-[0.6875rem] text-text-muted">lightbulb</span>
                            </div>
                            <div class="flex flex-col items-center gap-1">
                                <span class="material-symbols-outlined text-[24px]">rocket_launch</span>
                                <span class="font-code-sm text-[0.6875rem] text-text-muted">launch</span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Technology Stack -->
            <section class="flex flex-col space-y-6">
                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-surface-container flex items-center justify-center text-text-primary">
                        <span class="material-symbols-outlined text-[18px]">schema</span>
                    </div>
                    <div>
                        <h2 class="font-headline-lg text-headline-lg text-text-primary">Technology Stack &amp; Build Pipeline</h2>
                        <p class="font-body-sm text-body-sm text-text-muted">The minimal modern stack powering static generation and syndication.</p>
                    </div>
                </div>
                <div class="flex flex-col space-y-3">
                    {techStack.map((pkg) => (
                        <a class="group bg-surface-card p-5 rounded-xl shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:shadow-md transition-all" href={pkg.link} rel="noopener noreferrer" target="_blank">
                            <div class="flex items-start gap-4">
                                <div class="w-10 h-10 rounded-lg bg-surface-subtle flex items-center justify-center text-accent-flow group-hover:bg-accent-flow-soft transition-colors shrink-0">
                                    <span class="material-symbols-outlined text-[20px]">{pkg.icon}</span>
                                </div>
                                <div>
                                    <span class="font-headline-sm text-headline-sm text-text-primary group-hover:text-accent-flow transition-colors">{pkg.name}</span>
                                    <p class="font-body-sm text-body-sm text-text-secondary mt-1">{pkg.description}</p>
                                </div>
                            </div>
                            <span class="font-code-sm text-code-sm text-text-muted group-hover:text-accent-flow flex items-center gap-1 self-end sm:self-center shrink-0">
                                {pkg.domain} <span class="material-symbols-outlined text-[14px]">north_east</span>
                            </span>
                        </a>
                    ))}
                </div>
            </section>
        </div>
    </main>
</Layout>
