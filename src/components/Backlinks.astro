---
interface Props {
    backlinkedNotes: any[];
}

const { backlinkedNotes: rawBacklinkedNotes } = Astro.props;

const backlinkedNotes = rawBacklinkedNotes
    .map((note) => {
        const displayDate = note.data.publishedDate || new Date();
        return { ...note, displayDate };
    })
    .sort((a, b) => b.displayDate.getTime() - a.displayDate.getTime());
---

{
    backlinkedNotes.length > 0 && (
        <section>
            <div class="mb-8">
                <h3 class="font-code-sm text-code-sm uppercase tracking-widest text-text-muted">Connected Notes</h3>
            </div>

            <div>
                {backlinkedNotes.map((note) => (
                    <a href={`/notes/${note.id.replace('.md', '')}`} class="group block cursor-pointer">
                        <div class="flex-1">
                            <time class="font-code-sm text-[0.7rem] uppercase tracking-wider text-text-muted mb-2 block leading-none">
                                {note.displayDate.toLocaleDateString("en-US", {
                                    month: 'short',
                                    day: 'numeric',
                                    year: 'numeric',
                                    timeZone: 'UTC'
                                })}
                            </time>
                            <h4 class="font-display text-headline-md text-text-primary group-hover:text-accent-flow transition-colors leading-tight decoration-2 underline-offset-4 group-hover:underline">
                                {note.data.title}
                            </h4>
                            {note.data.summary && (
                                <p class="text-text-secondary text-body-md leading-relaxed max-w-xl">
                                    {note.data.summary}
                                </p>
                            )}
                        </div>
                    </a>
                ))}
            </div>
        </section>
    )
}
