<button
  id="theme-toggle"
  class="w-9 h-9 flex items-center justify-center rounded-lg text-text-secondary hover:text-text-primary hover:bg-surface-subtle transition-colors shrink-0"
  aria-label="Toggle dark mode"
>
  <span class="material-symbols-outlined sun-icon text-[19px]">light_mode</span>
  <span class="material-symbols-outlined moon-icon text-[19px]">dark_mode</span>
</button>

<style>
  .moon-icon {
    display: none;
  }
  
  :global(.dark) .sun-icon {
    display: none;
  }
  
  :global(.dark) .moon-icon {
    display: block;
  }
</style>

<script>
  function handleToggleClick() {
    const root = document.documentElement;
    root.classList.add("no-transitions");
    
    root.classList.toggle("dark");
    const isDark = root.classList.contains("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
    
    // Force a reflow to ensure the class is applied before transitions are re-enabled
    window.getComputedStyle(root).opacity;
    
    // Use a small timeout to ensure the browser has a chance to apply the theme change
    // without triggering any transitions.
    setTimeout(() => {
      root.classList.remove("no-transitions");
    }, 0);
  }

  // Set up the event listener
  const toggleBtn = document.getElementById("theme-toggle");
  if (toggleBtn) {
    toggleBtn.addEventListener("click", handleToggleClick);
  }
</script>
