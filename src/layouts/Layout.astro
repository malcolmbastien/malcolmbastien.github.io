---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import Analytics from "@vercel/analytics/astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    url?: string;
    type?: "website" | "article";
    publishedTime?: string;
    modifiedTime?: string;
    tags?: string[];
    author?: string;
    noindex?: boolean;
}

const {
    title,
    description = "Enterprise Agile Coach helping leaders in Fintech, Banking, and HealthTech build fast flow through systems thinking, aligned autonomy, and sociotechnical design.",
    image = "/malcolm_headshot.png",
    url = Astro.site?.origin || new URL(Astro.request.url).origin,
    type = "website",
    publishedTime,
    modifiedTime,
    tags = [],
    author = "Malcolm Bastien",
    noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || url).href;
const ogImage = image.startsWith("http") ? image : url + image;

const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();

const navItems = [
    { href: "/about", label: "About" },
    { href: "/archives", label: "Writing" },
    { href: "/topics", label: "Topics" },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="fediverse:creator" content="@malcolm@mastodon.social" />

        <!-- Fonts - Self-hosted Inter, Newsreader, JetBrains Mono, Material Symbols -->
        <link rel="preload" href="/fonts/inter-UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuLyfMZg.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/inter-UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuI6fMZg.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/inter-UcCO3FwrK3iLTeHuS_nVMrMxCp50SjIw2boKoduKmMEVuGKYMZg.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/newsreader-cY9kfjOCX1hbuyalUrK439vogqC9yFZCYg7oRZaLP4obnf7fTXglsMwoT-ZA.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/newsreader-cY9qfjOCX1hbuyalUrK49dLac06G1ZGsZBtoBCzBDXXD9JVF438weI_ADA.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/newsreader-cY9qfjOCX1hbuyalUrK49dLac06G1ZGsZBtoBCzBDXXD9JVF438wSo_ADA.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/newsreader-cY9qfjOCX1hbuyalUrK49dLac06G1ZGsZBtoBCzBDXXD9JVF438wpojADA.ttf" as="font" type="font/ttf" crossorigin />
        <link rel="preload" href="/fonts/material-symbols-kJF1BvYX7BgnkSrUwT8OhrdQw4oELdPIeeII9v6oDMzByHX9rA6RzaxHMPdY43zj-jCxv3fzvRNU22ZXGJpEpjC_1v-p_4MrImHCIJIZrDCvHOem.ttf" as="font" type="font/ttf" crossorigin />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <meta name="author" content={author} />
        <link rel="canonical" href={canonicalUrl} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:alt" content={title} />
        <meta property="og:site_name" content="Malcolm Bastien" />
        <meta property="og:locale" content="en_US" />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalUrl} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        <meta name="twitter:image:alt" content={title} />

        <!-- Additional SEO -->
        <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
        <meta name="language" content="English" />
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}

        {
            type === "article" && publishedTime && (
                <meta property="article:published_time" content={publishedTime} />
            )
        }
        {
            type === "article" && modifiedTime && (
                <meta property="article:modified_time" content={modifiedTime} />
            )
        }
        {
            type === "article" && (
                <meta property="article:author" content={author} />
            )
        }

        <!-- Structured Data -->
        <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": type === "article" ? "BlogPosting" : "WebSite",
                name: title,
                description: description,
                url: canonicalUrl,
                image: ogImage,
                author: {
                    "@type": "Person",
                    name: author,
                },
                publisher: {
                    "@type": "Organization",
                    name: "Malcolm Bastien",
                    url: url,
                },
                ...(type === "article" &&
                    publishedTime && { datePublished: publishedTime }),
                ...(type === "article" &&
                    modifiedTime && { dateModified: modifiedTime }),
                ...(type === "article" &&
                    tags.length > 0 && { keywords: tags.join(", ") }),
            })}
        />

        <slot name="head" />

        <Analytics />

        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "light") {
                document.documentElement.classList.remove("dark");
            } else {
                document.documentElement.classList.add("dark");
            }
            window.localStorage.setItem("theme", theme);
        </script>
        <script is:inline>
            document.addEventListener('keydown', function(e) {
                if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                    e.preventDefault();
                    const searchInput = document.getElementById('nav-search-input');
                    if (searchInput) {
                        searchInput.focus();
                    }
                }
            });
        </script>
    </head>
    <body class="min-h-screen flex flex-col bg-surface-page text-text-primary antialiased selection:bg-accent-flow-soft selection:text-accent-flow">
        <header class="w-full sticky top-0 z-50 bg-surface-page/90 backdrop-blur-md border-b border-border-delicate">
            <div class="max-w-page mx-auto px-margin-mobile md:px-gutter flex justify-between items-center h-20 gap-6">
                <a href="/" class="group flex flex-col shrink-0">
                    <span class="font-headline-sm text-headline-sm text-text-primary group-hover:text-accent-flow transition-colors">{author}</span>
                    <span class="font-code-sm text-[0.6875rem] text-text-muted tracking-wider uppercase -mt-0.5">Enterprise Agile Coach</span>
                </a>
                <nav class="hidden md:flex items-center gap-8">
                    {navItems.map((item) => {
                        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
                        return (
                            <a
                                href={item.href}
                                class:list={[
                                    "relative py-1 font-body-sm text-body-sm transition-colors",
                                    isActive
                                        ? "text-accent-flow font-medium"
                                        : "text-text-secondary hover:text-text-primary"
                                ]}
                            >
                                {item.label}
                            </a>
                        );
                    })}
                </nav>
                <div class="flex items-center gap-3">
                    <form action="/search" method="GET" class="relative">
                        <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-[18px] text-text-muted pointer-events-none">search</span>
                        <input
                            type="text"
                            name="q"
                            id="nav-search-input"
                            aria-label="Search writings"
                            class="w-36 sm:w-44 py-2 pl-9 pr-14 rounded-lg bg-surface-subtle border border-border-delicate hover:border-border-hover focus:border-accent-flow focus:ring-1 focus:ring-accent-flow/40 text-body-sm text-text-primary placeholder:text-text-muted transition-all outline-none"
                            placeholder="Search"
                            autocomplete="off"
                        />
                        <span class="hidden sm:inline-block absolute right-2 top-1/2 -translate-y-1/2 font-code-sm text-[0.6875rem] text-text-muted bg-surface-card px-1.5 py-0.5 rounded border border-border-delicate pointer-events-none">⌘K</span>
                    </form>
                    <ThemeToggle />
                </div>
            </div>
        </header>

        <slot />

        <!-- Site Footer -->
        <footer class="w-full bg-surface-footer border-t border-border-delicate mt-auto">
            <div class="max-w-page mx-auto px-margin-mobile md:px-gutter py-space-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                <p class="font-display text-lg text-text-primary">Malcolm Bastien</p>
                <div class="flex flex-wrap items-center gap-6 font-body-sm text-body-sm text-text-secondary">
                    <a class="hover:text-accent-flow transition-colors" href="/colophon">Colophon</a>
                    <a class="hover:text-accent-flow transition-colors" href="https://www.linkedin.com/in/malcolmbastien/" rel="noopener noreferrer" target="_blank">LinkedIn</a>
                    <a class="hover:text-accent-flow transition-colors" href="/rss.xml">RSS Feed</a>
                </div>
                <div class="font-code-sm text-code-sm text-text-muted flex items-center gap-2">
                    <span>&copy; {currentYear} Malcolm Bastien.</span>
                    <span role="img" aria-label="Canada" title="Canada">🍁</span>
                </div>
            </div>
        </footer>
    </body>
</html>
